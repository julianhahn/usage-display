{
  "schema_version": 1,
  "diagram_type": "architecture",
  "meta": {
    "title": "GPT Usage Display — Big Picture",
    "quality_profile": "showcase",
    "viewBox": [1100, 700]
  },
  "layout": {
    "mode": "grid",
    "origin": [80, 140],
    "cols": 4,
    "gapX": 50,
    "gapY": 100,
    "cellW": 200,
    "cellH": 130
  },
  "components": [
    {"id": "ntp", "type": "external", "label": "Cloudflare NTP", "sublabel": "unauthenticated time", "pos": [580, 20]},
    {"id": "startup", "type": "backend", "label": "Boot and Startup", "sublabel": "starts device flow", "row": 0, "col": 0},
    {"id": "credentials", "type": "security", "label": "Credential Store", "sublabel": "token + account ID", "row": 0, "col": 1},
    {"id": "wifi", "type": "cloud", "label": "Wi-Fi", "sublabel": "network connection", "row": 0, "col": 2},
    {"id": "client", "type": "backend", "label": "Usage API Adapter", "sublabel": "HTTPS + conversion", "row": 0, "col": 3},
    {"id": "openai", "type": "external", "label": "OpenAI Usage Service", "sublabel": "weekly usage", "row": 1, "col": 3, "size": [200, 130]},
    {"id": "state", "type": "database", "label": "Usage Snapshot", "sublabel": "current or last known", "row": 1, "col": 2},
    {"id": "oled", "type": "frontend", "label": "OLED Display", "sublabel": "shows remaining %", "row": 1, "col": 1},
    {"id": "julian", "type": "frontend", "label": "Julian", "sublabel": "views remaining usage", "row": 1, "col": 0}
  ],
  "connections": [
    {"from": "wifi", "to": "ntp", "label": "UDP 123"},
    {"from": "startup", "to": "credentials", "label": "reads", "route": "straight"},
    {"from": "credentials", "to": "wifi", "label": "provides config", "route": "straight"},
    {"from": "wifi", "to": "client", "label": "carries HTTPS", "route": "straight"},
    {"from": "client", "to": "openai", "label": "requests usage", "route": "orthogonal-v"},
    {"from": "client", "to": "state", "label": "stores result or error", "route": "orthogonal-v"},
    {"from": "state", "to": "oled", "label": "provides value", "route": "straight"},
    {"from": "oled", "to": "julian", "label": "shows value", "route": "straight"}
  ]
}
